{
  "name": "Butter Canvas - Canvas Tasks Extension",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "64": "images/BC_Logo_64.png",
    "128": "images/BC_Logo_256.png",
    "256": "images/BC_Logo_256.png"
  },
  "action": {
    "default_popup": "hello.html",
    "default_icon": "images/BC_Logo_256.png"
  },
  "host_permissions": [
    "https://courses.cs.vt.edu/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "matches": [
        "https://canvas.vt.edu/*"
      ]
    }
  ]
}