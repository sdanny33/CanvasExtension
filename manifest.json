{
  "name": "Canvas Extension",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "images/BCLOGO16.png",
    "32": "images/BCLOGO32.png",
    "48": "images/BCLOGO48.png",
    "128": "images/BCLOGO128.png"
  },
  "action": {
    "default_popup": "hello.html",
    "default_icon": "images/hello.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://canvas.vt.edu/*"
      ]
    }
  ]
}